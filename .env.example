# Configuration du prototype. Copier en `.env` et adapter.
# Toutes les valeurs sont surchargeables par variables d'environnement.

# SQLite par défaut : la démonstration locale tourne sans serveur de base.
# GARDES_DATABASE_URL=sqlite:///./gardes.db

# PostgreSQL (docker-compose) :
# GARDES_DATABASE_URL=postgresql+psycopg://gardes:gardes@db:5432/gardes

# Clé de signature des sessions. À remplacer impérativement hors démonstration.
GARDES_SECRET_KEY=prototype-demo-non-secret-a-remplacer-en-production

GARDES_TIMEZONE=Europe/Brussels
GARDES_ENVIRONMENT=demonstration

# --- Déploiement PaaS (Scalingo) ---
# Ne PAS définir GARDES_DATABASE_URL en production : l'application reprend
# automatiquement SCALINGO_POSTGRESQL_URL (ou DATABASE_URL) fournie par l'addon,
# normalise le schéma en postgresql+psycopg:// et ajoute sslmode=require.
# Définir en revanche, sur l'hébergeur :
#   GARDES_SECRET_KEY = <secret aléatoire long>
#   GARDES_ENVIRONMENT = production

# Valeurs de démonstration — voir OPEN_QUESTIONS.md
GARDES_DEFAULT_GRACE_PERIOD_HOURS=48
GARDES_DEFAULT_HOLIDAY_PAIR_REQUIREMENT=VERT_ORANGE
